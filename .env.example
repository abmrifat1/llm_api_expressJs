PORT=3000

# LLM Configuration
# Options: openai | groq | gemini
PROVIDER=groq
MODEL=openai/gpt-oss-120b # gpt-4o-mini | gemini-2.0-flash
MAX_TOKENS=1024

# API Keys
GROQ_API_KEY=*****
OPENAI_API_KEY=*****
GEMINI_API_KEY=*****

#Redis & BullMQ Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379